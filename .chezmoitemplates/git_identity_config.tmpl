{{- /* Validated identity data; quote separately for shell argv and Git syntax. */ -}}
{{- $key_path := joinPath .home (printf ".ssh/id_%s_%s_%s.pub" .key_type .email .key_hash) -}}
{{- $ssh_command := printf "ssh -i %s -o IdentitiesOnly=yes -o ControlPath=none" (includeTemplate "posix_shell_quote.tmpl" $key_path) -}}
{{- if hasKey . "ssh_command" -}}{{- $ssh_command = .ssh_command -}}{{- end -}}
# Auto-generated identity config.
[user]
    name = {{ includeTemplate "git_config_quote.tmpl" .name }}
    email = {{ includeTemplate "git_config_quote.tmpl" .email }}
    signingkey = {{ includeTemplate "git_config_quote.tmpl" (printf "key::%s" .public_key) }}
[core]
    sshCommand = {{ includeTemplate "git_config_quote.tmpl" $ssh_command }}
