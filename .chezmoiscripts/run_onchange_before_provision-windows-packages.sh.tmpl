{{ if .is_wsl -}}
#!/bin/sh
# WSL/Windows host package provisioning runs before target updates because
# rendered mise file tasks do not exist yet during first-run apply.
# [Trigger]: Schema Hash: {{ include ".chezmoidata/packages.yaml" | sha256sum }}

set -eu

echo "🔄 [Windows Packages] Updating WinGet package sources..."
winget.exe source update > /dev/null 2>&1 || true

install_winget_app() {
  app_id=$1
  if ! winget.exe list --id "$app_id" > /dev/null 2>&1; then
    echo "📦 [Windows Packages] Installing $app_id on Windows..."

    # Nightly packages can have volatile WinGet manifests.
    # Hash verification is bypassed only for nightly package IDs.
    # Conditional bypass is required to ensure non-interactive convergence.
    extra_flags=""
    if echo "$app_id" | grep -q "nightly"; then
      echo "  ⚠️  [Security] Volatile package detected. Bypassing hash verification: $app_id"
      extra_flags="--ignore-security-hash"
    fi

    winget.exe install --id "$app_id" \
      --silent \
      --accept-package-agreements \
      --accept-source-agreements \
      $extra_flags
  else
    echo "✅ [Windows Packages] $app_id is already installed on Windows."
  fi
}

echo "📦 [Windows Packages] Provisioning Windows host packages..."

# --- Headless Packages ---
{{ range .packages.headless.windows -}}
install_winget_app {{ . | quote }}
{{ end -}}

{{- if not (env "CI") }}
# --- Desktop & Media ---
{{ range .packages.gui.windows -}}
install_winget_app {{ . | quote }}
{{ end -}}

{{- end }}

echo "✅ [Windows Packages] Windows package provisioning complete."
{{ end -}}
