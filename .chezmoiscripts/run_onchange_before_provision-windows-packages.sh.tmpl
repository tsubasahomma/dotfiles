{{ if .is_wsl -}}
#!/bin/sh
# WSL/Windows host package provisioning runs before target updates because
# rendered mise file tasks do not exist yet during first-run apply.
# [Trigger]: Schema Hash: {{ include ".chezmoidata/packages.yaml" | sha256sum }}

set -eu

# Keep HRESULT and native command-line handling on Windows. Only a Base64
# UTF-16LE PowerShell program crosses WSL interop; Python classifies its JSON.
exec python3 - <<'DOTFILES_WINDOWS_PACKAGES_PY'
{{ includeTemplate "windows_packages.py" . }}
package_ids = json.loads(base64.b64decode('{{ .packages.headless.windows | toJson | b64enc }}'))
{{ if not (env "CI") -}}
package_ids += json.loads(base64.b64decode('{{ .packages.gui.windows | toJson | b64enc }}'))
{{ end -}}
sys.exit(main(package_ids))
DOTFILES_WINDOWS_PACKAGES_PY
{{ end -}}
