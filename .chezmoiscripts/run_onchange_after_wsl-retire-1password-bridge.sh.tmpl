{{- if .is_wsl -}}
#!/usr/bin/env bash
{{/* [Reference]: https://www.chezmoi.io/user-guide/use-scripts-to-perform-actions/ */}}{{ "" -}}
# Retire runtime state left by the previous WSL SSH-agent bridge design.
# [Trigger]: Retired WSL 1Password bridge cleanup version: 1

set -euo pipefail

if [[ "${CI:-false}" == "true" ]]; then
  echo "Skipping retired WSL 1Password bridge cleanup in CI."
  exit 0
fi

UNIT="1password-bridge.service"
SOCKET="{{ .paths.home }}/.1password/agent.sock"

if command -v systemctl >/dev/null 2>&1; then
  if systemctl --user is-active --quiet "$UNIT" 2>/dev/null; then
    echo "Stopping retired WSL 1Password bridge user service..."
    systemctl --user stop "$UNIT" || true
  fi

  systemctl --user disable "$UNIT" >/dev/null 2>&1 || true
  systemctl --user reset-failed "$UNIT" >/dev/null 2>&1 || true
  systemctl --user daemon-reload >/dev/null 2>&1 || true

  if systemctl --user is-active --quiet "$UNIT" 2>/dev/null; then
    echo "Retired WSL 1Password bridge user service is still active." >&2
    exit 1
  fi
fi

rm -f "$SOCKET"
echo "Retired WSL 1Password bridge runtime state removed."
{{- end }}
