#!/bin/zsh
# Delegate static Zsh asset convergence to mise-managed tooling.
# [Trigger]: completion alias data: {{ include ".chezmoidata/completions.yaml" | sha256sum }}
# [Trigger]: static tool manifest hash: {{ include "dot_config/mise/conf.d/10-tools.toml" | sha256sum }}
{{/* [Reference]: https://www.chezmoi.io/user-guide/use-scripts-to-perform-actions/ */}}{{ "" -}}

set -euo pipefail

echo "⚡ [Delegate] Invoking mise task: converge:completions"
exec "{{ .paths.mise }}" run converge:completions
