{{ if eq .osid "linux" -}}
#!/bin/sh
# Linux package-manager provisioning runs before target updates because rendered
# mise file tasks do not exist yet during first-run apply.
# [Trigger]: Linux package list hash: {{ includeTemplate "linux-packages.list.tmpl" . | sha256sum }}

set -eu

# Non-interactive sudo avoids silent hangs during automated provisioning.
if ! sudo -n true 2>/dev/null; then
  echo "❌ [Fatal] Non-interactive sudo is not configured."
  echo "👉 Action Required: Run 'sudo visudo' and configure passwordless sudo for this user."
  echo "   Example: $USER ALL=(ALL) NOPASSWD:ALL"
  exit 1
fi

OS_RELEASE_PATH=""
if [ -r "/etc/os-release" ]; then
  OS_RELEASE_PATH="/etc/os-release"
elif [ -r "/usr/lib/os-release" ]; then
  OS_RELEASE_PATH="/usr/lib/os-release"
fi

if [ -z "$OS_RELEASE_PATH" ]; then
  echo "❌ [Fatal] OS identification file missing."
  exit 1
fi

. "$OS_RELEASE_PATH"

case "$ID" in
  ubuntu|debian) PM="apt" ;;
  fedora|rhel)   PM="dnf" ;;
  arch)          PM="pacman" ;;
  *)
    echo "❌ [Fatal] Unsupported distribution: $ID"
    exit 1
    ;;
esac

install_linux_packages() {
  packages="$*"
  echo "📦 [Linux Packages] Installing packages via $PM: $packages"

  case "$PM" in
    apt)
      sudo apt-get update -y
      sudo apt-get install -y $packages
      ;;
    dnf)
      sudo dnf install -y $packages
      ;;
    pacman)
      sudo pacman -S --noconfirm $packages
      ;;
  esac
}

TEMP_PKG_LIST=$(mktemp)
trap 'rm -f "$TEMP_PKG_LIST"' EXIT
cat << 'EOF' > "$TEMP_PKG_LIST"
{{ includeTemplate "linux-packages.list.tmpl" . }}
EOF

TARGET_PKGS=$(grep -vE '^\s*(#|$)' "$TEMP_PKG_LIST" | xargs)
if [ -n "$TARGET_PKGS" ]; then
  install_linux_packages "$TARGET_PKGS"
fi

echo "✅ [Linux Packages] Linux package provisioning complete ($ID)."
{{ end -}}
