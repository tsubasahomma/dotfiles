{{- if .is_wsl -}}
#!/usr/bin/env bash
{{/* [Reference]: https://www.chezmoi.io/user-guide/use-scripts-to-perform-actions/ */}}{{ "" -}}
{{/* [Reference]: https://www.chezmoi.io/reference/application-order/ */}}{{ "" -}}
# WSL post-apply sync and service convergence delegates host side effects to
# explicit repo-owned mise tasks after rendered target files are available.
# [Trigger]: WSL lifecycle task hash: {{ include "dot_config/mise/repo-tasks/lifecycle/executable_wsl-post-apply.tmpl" | sha256sum }}
# [Trigger]: 1Password agent config hash: {{ includeTemplate "dot_config/1Password/ssh/private_agent.toml.tmpl" . | sha256sum }}
# [Trigger]: 1Password agent sync task hash: {{ include "dot_config/mise/repo-tasks/sync/executable_1password-agent.tmpl" | sha256sum }}
# [Trigger]: WezTerm config hash: {{ include "dot_config/wezterm/wezterm.lua.tmpl" | sha256sum }}
# [Trigger]: WezTerm sync task hash: {{ include "dot_config/mise/repo-tasks/sync/executable_wezterm.tmpl" | sha256sum }}
# [Trigger]: 1Password bridge service hash: {{ include "dot_config/systemd/user/1password-bridge.service.tmpl" | sha256sum }}
# [Trigger]: 1Password bridge service task hash: {{ include "dot_config/mise/repo-tasks/service/executable_1password-bridge.tmpl" | sha256sum }}

set -euo pipefail

if [[ "${CI:-false}" == "true" ]]; then
  echo "Skipping WSL sync/service lifecycle in CI."
  exit 0
fi

export PNPM_HOME="{{ .paths.xdg_data }}/pnpm"
export PATH="$PNPM_HOME:{{ .paths.home }}/.local/bin:$PATH"

MISE_BIN="{{ .paths.mise }}"

if [[ ! -x "$MISE_BIN" ]]; then
  echo "Hermetic mise binary not found at $MISE_BIN." >&2
  exit 1
fi

echo "Running WSL sync and service lifecycle..."
"$MISE_BIN" run lifecycle:wsl-post-apply
echo "WSL sync and service lifecycle complete."
{{- end }}
