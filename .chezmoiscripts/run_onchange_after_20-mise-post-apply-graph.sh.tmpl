#!/usr/bin/env bash
{{/* [Reference]: https://www.chezmoi.io/user-guide/use-scripts-to-perform-actions/ */}}{{ "" -}}
# Platform-neutral post-apply convergence is delegated to the repo-owned mise graph.
# The 20 prefix prepares tools before the dedicated 30/40/41/42/50 checks.
# [Trigger]: dynamic mise config hash: {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}
# [Trigger]: static tool manifest hash: {{ include "dot_config/mise/conf.d/10-tools.toml" | sha256sum }}
# [Trigger]: external asset manifest hash: {{ include ".chezmoiexternal.toml.tmpl" | sha256sum }}
# [Trigger]: post-apply lifecycle task hash: {{ include "dot_config/mise/repo-tasks/lifecycle/executable_post-apply.tmpl" | sha256sum }}
# [Trigger]: security repair task hash: {{ include "dot_config/mise/repo-tasks/repair/executable_security.tmpl" | sha256sum }}
# [Trigger]: Linux shell provision task hash: {{ include "dot_config/mise/repo-tasks/provision/executable_linux-shell.tmpl" | sha256sum }}
# [Trigger]: pnpm provision task hash: {{ include "dot_config/mise/repo-tasks/provision/executable_pnpm.tmpl" | sha256sum }}

set -euo pipefail

# This script runs before the new Zsh environment is fully initialized.
# Export the rendered XDG contract before mise or tool subprocesses derive paths.
export XDG_CONFIG_HOME={{ includeTemplate "posix_shell_quote.tmpl" .paths.xdg_config }}
export XDG_DATA_HOME={{ includeTemplate "posix_shell_quote.tmpl" .paths.xdg_data }}
export XDG_STATE_HOME={{ includeTemplate "posix_shell_quote.tmpl" .paths.xdg_state }}
export XDG_CACHE_HOME={{ includeTemplate "posix_shell_quote.tmpl" .paths.xdg_cache }}

# PATH injection is required because this subshell executes before Zsh bootstrap completes.
export PNPM_HOME={{ includeTemplate "posix_shell_quote.tmpl" (joinPath .paths.xdg_data "pnpm") }}
LOCAL_BIN={{ includeTemplate "posix_shell_quote.tmpl" (joinPath .paths.home ".local/bin") }}
export PATH="$PNPM_HOME:$LOCAL_BIN:$PATH"

MISE_BIN={{ includeTemplate "posix_shell_quote.tmpl" .paths.mise }}
OP_BIN={{ includeTemplate "posix_shell_quote.tmpl" .paths.op }}
MISE_GITHUB_CREDENTIAL_COMMAND_VALUE=""

configure_mise_github_auth() {
  if [[ -n "${MISE_GITHUB_TOKEN:-}" || -n "${GITHUB_API_TOKEN:-}" || -n "${GITHUB_TOKEN:-}" ]]; then
    return
  fi

  if [[ -z "$OP_BIN" ]]; then
    return
  fi

  local credential_command
  printf -v credential_command "%q read %q" "$OP_BIN" "op://Development/mise-cli-token/credential"
  MISE_GITHUB_CREDENTIAL_COMMAND_VALUE="$credential_command"
}

if [[ ! -x "$MISE_BIN" ]]; then
  echo "❌ [Fatal] Hermetic mise binary not found at $MISE_BIN." >&2
  exit 1
fi

echo "📦 [Post-apply] Executing repo-owned mise graph..."
configure_mise_github_auth

# Install declared tools idempotently.
if [[ -n "$MISE_GITHUB_CREDENTIAL_COMMAND_VALUE" ]]; then
  MISE_GITHUB_CREDENTIAL_COMMAND="$MISE_GITHUB_CREDENTIAL_COMMAND_VALUE" "$MISE_BIN" install
else
  "$MISE_BIN" install
fi

"$MISE_BIN" run lifecycle:post-apply

echo "✅ [Post-apply] Mise graph complete."
