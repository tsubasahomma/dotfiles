{{ if eq .osid "darwin" -}}
#!/bin/zsh
# macOS Homebrew provisioning runs before target updates because rendered mise
# file tasks do not exist yet during first-run apply.
# dot_config/homebrew/Brewfile.tmpl hash: {{ include "dot_config/homebrew/Brewfile.tmpl" | sha256sum }}

set -euo pipefail

# Homebrew itself is an explicit first-install prerequisite, not an apply action.
# Use the caller's selected installation; do not switch prefixes via shellenv.
if ! command -v brew >/dev/null 2>&1; then
  echo "❌ [Fatal] Homebrew is required in PATH. Prepare it explicitly: https://brew.sh; see docs/operations.md#homebrew-packages." >&2
  exit 1
fi

# Keep ordinary apply separate from maintenance. Required dependency installs,
# links and package post-install actions can still change the host.
export HOMEBREW_NO_AUTO_UPDATE=1
unset HOMEBREW_FORCE_API_AUTO_UPDATE
export HOMEBREW_NO_INSTALL_CLEANUP=1
export HOMEBREW_NO_INSTALLED_DEPENDENTS_CHECK=1
# Inherited Bundle preferences must not remove undeclared packages or skip
# required declarations. These changes are local to this script's process.
unset HOMEBREW_BUNDLE_INSTALL_CLEANUP HOMEBREW_BUNDLE_FORCE_INSTALL_CLEANUP
unset HOMEBREW_BUNDLE_BREW_SKIP HOMEBREW_BUNDLE_CASK_SKIP

TEMP_BREWFILE=$(mktemp)
trap 'rm -f "$TEMP_BREWFILE"' EXIT
cat << 'EOF' > "$TEMP_BREWFILE"
{{ includeTemplate "dot_config/homebrew/Brewfile.tmpl" . }}
EOF

echo "📦 [Homebrew Packages] Installing Brewfile bundle: $TEMP_BREWFILE"
brew bundle install --no-upgrade --file="$TEMP_BREWFILE"

echo "✅ [Homebrew Packages] Homebrew package provisioning complete."
{{ end -}}
