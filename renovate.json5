// GitHub must require Required CI and an up-to-date branch before enabling automerge.
// https://docs.renovatebot.com/key-concepts/automerge/
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "labels": ["dependencies", "renovate"],
  "mise": {
    "managerFilePatterns": ["/^\\.mise\\.toml$/", "/^dot_config/mise/conf\\.d/.*\\.toml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Govern the plain mise bootstrap pin without replacing native mise TOML extraction.",
      "managerFilePatterns": ["/^\\.mise-version$/"],
      "matchStrings": ["^(?<currentValue>\\d+\\.\\d+\\.\\d+)(?:\\r?\\n)?$"],
      "depNameTemplate": "jdx/mise",
      "packageNameTemplate": "jdx/mise",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.+)$",
      "versioningTemplate": "semver-coerced"
    }
  ],
  "packageRules": [
    {
      "description": "Keep dependency changes independent; only the shared chezmoi pin is grouped below.",
      "matchManagers": ["mise", "github-actions", "custom.regex"],
      "groupName": null
    },
    {
      "description": "Update bootstrap and rendered global chezmoi declarations together.",
      "matchManagers": ["mise"],
      "matchDepNames": ["aqua:twpayne/chezmoi"],
      "groupName": "chezmoi mise tool"
    }
  ],
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "rebaseWhen": "behind-base-branch",
  "prConcurrentLimit": 3,
  "lockFileMaintenance": {
    "enabled": false
  }
}
