// GitHub must require Required CI and an up-to-date branch before enabling automerge.
// https://docs.renovatebot.com/key-concepts/automerge/
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "customManagers:githubActionsVersions"],
  "labels": ["dependencies", "renovate"],
  "mise": {
    "managerFilePatterns": ["/^\\.mise\\.toml$/", "/^dot_config/mise/conf\\.d/.*\\.toml$/"]
  },
  // Disabled by default upstream; opt in so hook revisions do not go stale.
  // https://docs.renovatebot.com/modules/manager/pre-commit/
  "pre-commit": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Govern the plain mise bootstrap pin without replacing native mise TOML extraction.",
      "managerFilePatterns": ["/^\\.mise-version$/"],
      "matchStrings": ["^(?<currentValue>\\d+\\.\\d+\\.\\d+)(?:\\r?\\n)?$"],
      "depNameTemplate": "jdx/mise",
      "packageNameTemplate": "jdx/mise",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v?(?<version>.+)$",
      "versioningTemplate": "semver-coerced"
    }
  ],
  "packageRules": [
    {
      "description": "Validate routine tool and action updates together once a week.",
      "matchManagers": ["mise", "github-actions", "custom.regex", "pre-commit"],
      "groupName": "weekly dependencies",
      "groupSlug": "weekly-dependencies",
      "separateMajorMinor": false
    }
  ],
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "rebaseWhen": "behind-base-branch",
  "timezone": "Asia/Tokyo",
  // Create new branches in the Monday window. Existing branches can rebase
  // between windows to keep Required CI current with main.
  "schedule": ["* * * * 1"],
  "prConcurrentLimit": 1,
  "lockFileMaintenance": {
    "enabled": false
  }
}
