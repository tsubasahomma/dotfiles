#!/usr/bin/env bash
# [MISE] description="Enable WSL2 1Password bridge user service"
{{/* [Reference]: https://developer.1password.com/docs/ssh/integrations/wsl/ */}}{{ "" -}}
{{/* [Reference]: https://mise.jdx.dev/tasks/file-tasks.html */}}{{ "" -}}

set -euo pipefail

IS_WSL="{{ .is_wsl }}"
NPIPERELAY_WSL="{{ .npiperelay_wsl }}"

if [[ "$IS_WSL" != "true" ]]; then
  echo "Skipping 1Password bridge service outside WSL."
  exit 0
fi

if [[ "${CI:-false}" == "true" ]]; then
  echo "Skipping 1Password bridge service enablement in CI."
  exit 0
fi

if [[ -z "$NPIPERELAY_WSL" ]]; then
  echo "npiperelay.exe was not discovered from WSL; no bridge service rendered."
  exit 0
fi

if ! command -v systemctl >/dev/null 2>&1; then
  echo "systemctl is required for WSL2 user service enablement." >&2
  exit 1
fi

echo "Enabling WSL2 1Password bridge user service..."
systemctl --user daemon-reload
systemctl --user enable --now 1password-bridge.service
echo "WSL2 1Password bridge user service is enabled."
