#!/bin/zsh
# [MISE] description="Validate and switch the Git identity generation (--clear for intentional empty input)"
# [MISE] depends=["repair:security"]
# Run whenever invoked: a directory mtime cannot prove the selected generation.
if ! command -v python3 >/dev/null 2>&1; then
  echo 'identity: Python 3.9+ must be on PATH before apply/generate (see docs/operations.md)' >&2
  exit 1
fi
exec python3 - {{ includeTemplate "posix_shell_quote.tmpl" (includeTemplate "identity_payload.tmpl" .) }} generate "$@" <<'DOTFILES_IDENTITY_PY'
{{ include ".chezmoitemplates/identity_transaction.py" }}
DOTFILES_IDENTITY_PY
