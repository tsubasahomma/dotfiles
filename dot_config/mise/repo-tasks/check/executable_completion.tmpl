#!/usr/bin/env bash
# [MISE] description="Inspect cached completion and init assets without executing them"
# [MISE] hide=true
set -euo pipefail
{{ includeTemplate "diagnostic_shell.tmpl" . }}
COMP_DIR={{ includeTemplate "posix_shell_quote.tmpl" (joinPath .paths.xdg_cache "zsh/completions") }}
INIT_DIR={{ includeTemplate "posix_shell_quote.tmpl" (joinPath .paths.xdg_cache "zsh/init") }}
for name in mise gh rg fd uv starship yq doggo kubectl helm k9s lazygit pnpm codex scc delta chezmoi gcloud; do
  require_file "$COMP_DIR/_$name"
done
for name in zoxide.zsh starship.zsh gcloud.zsh.inc; do
  require_file "$INIT_DIR/$name"
done
[[ -s "$COMP_DIR/_wezterm" ]] || log_warn "Optional WezTerm completion missing."
[[ -s "$COMP_DIR/_hs" ]] || log_warn "Optional HubSpot completion missing (not produced by the generator)."
log_warn "Asset presence only; syntax, freshness and CLI generation are not checked."
exit "$HAS_ERROR"
