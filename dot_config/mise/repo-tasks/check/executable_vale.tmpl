#!/usr/bin/env bash
# [MISE] description="Inspect Vale assets without running Vale"
# [MISE] hide=true
set -euo pipefail
{{ includeTemplate "diagnostic_shell.tmpl" . }}
require_file {{ includeTemplate "posix_shell_quote.tmpl" (joinPath .paths.xdg_config "vale/vale.ini") }}
STYLE_DIR={{ includeTemplate "posix_shell_quote.tmpl" (joinPath .paths.xdg_data "vale/styles/Google") }}
[[ -d "$STYLE_DIR" ]] || log_err "Required Vale Google style directory missing."
require_command vale
log_warn "Vale configuration parsing and rule behavior are not checked."
exit "$HAS_ERROR"
