#!/usr/bin/env bash
# [MISE] description="Verify mise binary version, configuration presence, and PATH precedence"
# [MISE] hide=true
{{/* [Reference]: https://mise.jdx.dev/tasks/file-tasks.html */}}{{ "" -}}

set -euo pipefail
{{ includeTemplate "diagnostic_shell.tmpl" . }}

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log_ok() { printf "  ${GREEN}✅ %s${NC}\n" "$1"; }
log_warn() { printf "  ${YELLOW}⚠️  %s${NC}\n" "$1"; }
log_err() { printf "  ${RED}❌ %s${NC}\n" "$1"; }
log_guide() { printf "  ${BLUE}👉 %s${NC}\n" "$1"; }

IS_CI="${CI:-false}"
HOME_DIR={{ includeTemplate "posix_shell_quote.tmpl" .paths.home }}
SOURCE_DIR={{ includeTemplate "posix_shell_quote.tmpl" .chezmoi.sourceDir }}
RENDERED_MISE_BIN={{ includeTemplate "posix_shell_quote.tmpl" .paths.mise }}
MISE_CONFIG_FILE={{ includeTemplate "posix_shell_quote.tmpl" (joinPath .paths.xdg_config "mise/config.toml") }}
MISE_VERSION_FILE="$SOURCE_DIR/.mise-version"
EXPECTED_MISE_BIN="$HOME_DIR/.local/bin/mise"
EXPECTED_MISE_VERSION=""
HAS_ERROR=0
# Even --version enters mise startup (migration, pruning and latest-version lookup).
# Run only this query in disposable state, without caller config or env overrides.
# This is isolation by directory/settings, not a sandbox for an untrusted binary.
query_mise_version() (
  version_tmp=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-mise-version.XXXXXXXX") || exit 1
  trap 'rm -rf -- "$version_tmp"' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  CDPATH= cd -P -- "$version_tmp" || exit 1
  # mise compares cwd/ceiling paths literally, including through TMPDIR symlinks.
  version_tmp="$PWD"
  /usr/bin/env -i PATH=/usr/bin:/bin LC_ALL=C HOME="$version_tmp" TMPDIR="$version_tmp" \
    XDG_CONFIG_HOME="$version_tmp/config" XDG_DATA_HOME="$version_tmp/data" \
    XDG_CACHE_HOME="$version_tmp/cache" XDG_STATE_HOME="$version_tmp/state" \
    MISE_CONFIG_DIR="$version_tmp/config/mise" MISE_DATA_DIR="$version_tmp/data/mise" \
    MISE_CACHE_DIR="$version_tmp/cache/mise" MISE_STATE_DIR="$version_tmp/state/mise" \
    MISE_SYSTEM_CONFIG_DIR="$version_tmp/system" MISE_SYSTEM_DATA_DIR="$version_tmp/system-data" \
    MISE_CEILING_PATHS="$version_tmp" \
    MISE_NO_CONFIG=true MISE_NO_ENV=true MISE_NO_HOOKS=true \
    MISE_AUTO_INSTALL=false MISE_TASK_RUN_AUTO_INSTALL=false MISE_NOT_FOUND_AUTO_INSTALL=false \
    MISE_CACHE_PRUNE_AGE=0s MISE_OFFLINE=true CI=true \
    "$EXPECTED_MISE_BIN" --version
)

read_expected_mise_version() {
  if [[ ! -f "$MISE_VERSION_FILE" ]]; then
    log_err "mise version contract missing at $MISE_VERSION_FILE."
    log_guide "Add a single-line .mise-version file containing the required mise release."
    HAS_ERROR=1
    return
  fi

  local line_count
  line_count="$(awk 'END { print NR }' "$MISE_VERSION_FILE")"
  EXPECTED_MISE_VERSION="$(sed -n '1p' "$MISE_VERSION_FILE")"
  if [[ "$line_count" -ne 1 || ! "$EXPECTED_MISE_VERSION" =~ ^[0-9]+[.][0-9]+[.][0-9]+$ ]]; then
    log_err ".mise-version must contain exactly one plain version such as 2026.5.4."
    log_guide "Remove comments, prefixes, blank lines, and extra whitespace from $MISE_VERSION_FILE."
    EXPECTED_MISE_VERSION=""
    HAS_ERROR=1
  fi
}

echo "--- 6. Toolchain Drift Analysis ---"
read_expected_mise_version

printf "  Expected hermetic mise path: %s\n" "$EXPECTED_MISE_BIN"
printf "  Expected hermetic mise version: %s\n" "${EXPECTED_MISE_VERSION:-<unresolved>}"
printf "  Rendered mise path: %s\n" "$RENDERED_MISE_BIN"
printf "  Rendered mise config: %s\n" "$MISE_CONFIG_FILE"

if [[ "$RENDERED_MISE_BIN" == "$EXPECTED_MISE_BIN" ]]; then
  log_ok "Rendered mise path uses the hermetic binary."
else
  log_err "Rendered mise path is $RENDERED_MISE_BIN, expected $EXPECTED_MISE_BIN."
  log_guide "Ensure chezmoi data.paths.mise resolves to the repo-managed hermetic binary."
  HAS_ERROR=1
fi

if [[ -f "$MISE_CONFIG_FILE" && -s "$MISE_CONFIG_FILE" && -r "$MISE_CONFIG_FILE" ]]; then
  if grep -Eq '^[[:space:]]*credential_command[[:space:]]*=' "$MISE_CONFIG_FILE"; then
    log_err "Global mise config defines a GitHub credential command."
    log_guide "Keep promptful GitHub auth scoped to post-apply install via MISE_GITHUB_CREDENTIAL_COMMAND."
    HAS_ERROR=1
  else
    log_ok "Global mise config does not define a promptful GitHub credential command."
  fi
else
  log_err "Required rendered mise config is missing, empty or unreadable."
  HAS_ERROR=1
fi

if [[ -n "${MISE_GITHUB_CREDENTIAL_COMMAND:-}" ]]; then
  log_warn "MISE_GITHUB_CREDENTIAL_COMMAND is set in the current environment."
  log_guide "Avoid exporting it globally; the dotfiles apply graph scopes it to post-apply install."
fi

if [[ -x "$EXPECTED_MISE_BIN" ]]; then
  version_status=0
  actual_mise_output="$(query_mise_version 2>&1)" || version_status=$?
  actual_mise_version="$(printf '%s\n' "$actual_mise_output" | awk 'NR == 1 { print $1 }')"
  printf "  Actual hermetic mise path: %s\n" "$EXPECTED_MISE_BIN"
  printf "  Actual hermetic mise version: %s\n" "${actual_mise_version:-<unavailable>}"

  if [[ "$version_status" -eq 0 && -n "$EXPECTED_MISE_VERSION" && "$actual_mise_version" == "$EXPECTED_MISE_VERSION" ]]; then
    log_ok "Hermetic mise binary matches the declared version."
  else
    log_err "Hermetic mise version command failed or the version mismatched."
    log_guide "Inspect the owner and version of $EXPECTED_MISE_BIN; adopt the version in .mise-version or arrange an explicit replacement. Apply does not replace mise."
    HAS_ERROR=1
  fi

  log_warn "Usage completion execution is not checked; use dotfiles-diagnose --probe toolchain."
else
  printf "  Actual hermetic mise version: <missing>\n"
  log_err "Hermetic mise executable missing at $EXPECTED_MISE_BIN."
  log_guide "If absent, run sh \"$SOURCE_DIR/.bootstrap-mise.sh\" --install. If present but unusable, inspect its owner/type/mode and repair it explicitly."
  HAS_ERROR=1
fi

if [[ "$IS_CI" != "true" ]]; then
  # Verify PATH precedence for mise and aqua before system binaries.
  # This catches accidental fallback to globally installed tools.
  # Static index-0 checks are avoided to support dynamic mise activation.
  SYS_PATH="/usr/bin"
  LOCAL_BIN="$HOME_DIR/.local/bin"
  if [[ "$PATH" == *"$LOCAL_BIN"* ]] && [[ "${PATH%%"$LOCAL_BIN"*}" != *"$SYS_PATH"* ]]; then
    log_ok "PATH precedence correctly prioritized (Infrastructure over System)."
  else
    log_warn "PATH precedence violation detected. Infrastructure paths might be shadowed."
    log_guide "Verify your shell initialization order in dot_zshrc."
  fi
fi

exit "$HAS_ERROR"
