#!/usr/bin/env bash
# [MISE] description="Compare Neovim lock bytes without starting Neovim"
# [MISE] hide=true
set -euo pipefail
{{ includeTemplate "diagnostic_shell.tmpl" . }}
LOCK_FILE={{ includeTemplate "posix_shell_quote.tmpl" (joinPath .paths.xdg_config "nvim/lazy-lock.json") }}
SOURCE_LOCK={{ includeTemplate "posix_shell_quote.tmpl" (joinPath .chezmoi.sourceDir "dot_config/nvim/lazy-lock.json") }}
require_file "$LOCK_FILE"
require_file "$SOURCE_LOCK"
if [[ "$HAS_ERROR" -eq 0 ]]; then
  if cmp -s "$SOURCE_LOCK" "$LOCK_FILE"; then
    log_ok "Neovim lock bytes match the current source file."
  else
    log_err "Neovim lock drift detected (also a failure in CI)."
  fi
fi
require_command nvim
log_warn "Provider execution and installed plugin revisions are not checked; use dotfiles-diagnose --probe nvim for isolated provider discovery."
exit "$HAS_ERROR"
