#!/usr/bin/env bash
# [MISE] description="Verify Vale configuration and style packages"
# [MISE] hide=true
{{/* [Reference]: https://mise.jdx.dev/tasks/file-tasks.html */}}{{ "" -}}

set -euo pipefail
{{ includeTemplate "diagnostic_shell.tmpl" . }}

GREEN='\033[0;32m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m'

log_ok() { printf "  ${GREEN}✅ %s${NC}\n" "$1"; }
log_err() { printf "  ${RED}❌ %s${NC}\n" "$1"; }
log_guide() { printf "  ${BLUE}👉 %s${NC}\n" "$1"; }

VALE_CONFIG={{ includeTemplate "posix_shell_quote.tmpl" (joinPath .paths.xdg_config "vale/vale.ini") }}
HAS_ERROR=0

echo "--- 5. Prose Linting Engine (Vale) ---"
if [[ -f "$VALE_CONFIG" ]]; then
  if vale --config="$VALE_CONFIG" ls-config > /dev/null; then
    log_ok "Vale configuration loaded successfully."

    STYLE_DIR={{ includeTemplate "posix_shell_quote.tmpl" (joinPath .paths.xdg_data "vale/styles/Google") }}
    if [[ -d "$STYLE_DIR" ]]; then
      log_ok "External style packages (Google) provisioned."
    else
      log_err "External style packages missing at $STYLE_DIR."
      printf -v vale_sync_command '/bin/bash %q' {{ includeTemplate "posix_shell_quote.tmpl" (joinPath .paths.xdg_config "mise/repo-tasks/sync/vale") }}
      log_guide "chezmoi apply (or run the receipt-aware sync task: $vale_sync_command)"
      HAS_ERROR=1
    fi
  else
    log_err "Vale failed to parse configuration at $VALE_CONFIG."
    HAS_ERROR=1
  fi
else
  log_err "Vale configuration missing at $VALE_CONFIG."
  log_guide "chezmoi apply"
  HAS_ERROR=1
fi

exit "$HAS_ERROR"
