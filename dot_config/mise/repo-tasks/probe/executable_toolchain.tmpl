#!/usr/bin/env bash
# [MISE] description="Execute mise usage and usage completion capability probe"
# [MISE] hide=true
set -euo pipefail
{{ includeTemplate "diagnostic_shell.tmpl" . }}
CHECK={{ includeTemplate "posix_shell_quote.tmpl" (joinPath .paths.xdg_config "mise/repo-tasks/check/toolchain") }}
/bin/bash "$CHECK"
MISE_BIN={{ includeTemplate "posix_shell_quote.tmpl" .paths.mise }}
require_command usage
[[ "$HAS_ERROR" -eq 0 ]] || exit "$HAS_ERROR"
TMP_DIR=$(mktemp -d)
trap 'rm -rf "$TMP_DIR"' EXIT
if ! "$MISE_BIN" usage >"$TMP_DIR/spec" 2>"$TMP_DIR/err"; then
  log_err "mise usage generation failed."
  exit 1
fi
if ! usage complete-word --shell zsh -f "$TMP_DIR/spec" -- mise run >"$TMP_DIR/out" 2>"$TMP_DIR/err"; then
  log_err "usage completion failed."
elif [[ -s "$TMP_DIR/err" ]] || grep -Eq '^\[WARN[[:space:]]+usage::spec\]' "$TMP_DIR/out"; then
  log_err "usage completion emitted diagnostics."
else
  log_ok "usage completed the mise spec without diagnostics."
fi
exit "$HAS_ERROR"
