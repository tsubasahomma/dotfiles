#!/usr/bin/env bash
# [MISE] description="Sync owned Windows 1password-agent setting"
set -euo pipefail
if [[ "{{ .is_wsl }}" != "true" || "${CI:-false}" == "true" ]]; then
  echo "[N/A] Windows 1password-agent sync outside non-CI WSL."
  exit 0
fi
exec python3 - 1password-agent {{ template "posix_shell_quote.tmpl" (joinPath .paths.xdg_config "1Password/ssh/agent.toml") }} <<'PY_WINDOWS_SYNC'
{{ include ".chezmoitemplates/windows_config_sync.py" }}
PY_WINDOWS_SYNC
