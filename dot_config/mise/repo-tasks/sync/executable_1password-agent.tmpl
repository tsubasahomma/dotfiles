#!/usr/bin/env bash
# [MISE] description="Sync 1Password SSH agent config to Windows host"
{{/* [Reference]: https://developer.1password.com/docs/ssh/agent/config/ */}}{{ "" -}}
{{/* [Reference]: https://developer.1password.com/docs/ssh/integrations/wsl/ */}}{{ "" -}}

set -euo pipefail

IS_WSL="{{ .is_wsl }}"
SRC_CONFIG="{{ .paths.xdg_config }}/1Password/ssh/agent.toml"

if [[ "$IS_WSL" != "true" ]]; then
  echo "Skipping 1Password agent Windows sync outside WSL."
  exit 0
fi

if [[ "${CI:-false}" == "true" ]]; then
  echo "Skipping 1Password agent Windows sync in CI."
  exit 0
fi

if [[ ! -f "$SRC_CONFIG" ]]; then
  echo "1Password agent config not found at $SRC_CONFIG. Skipping sync."
  exit 0
fi

WIN_HOME=$(powershell.exe -NoProfile -NonInteractive -Command '[Console]::Write($env:USERPROFILE)' | tr -d '\r')
if [[ -z "$WIN_HOME" ]]; then
  echo "Windows user profile path could not be resolved from WSL." >&2
  exit 1
fi

DST_CONFIG_WIN="$(wslpath -u "$WIN_HOME")/AppData/Local/1Password/config/ssh/agent.toml"

echo "Syncing 1Password SSH agent config to Windows..."
install -d "$(dirname "$DST_CONFIG_WIN")"
cp -f "$SRC_CONFIG" "$DST_CONFIG_WIN"
echo "1Password SSH agent config synced to Windows."
