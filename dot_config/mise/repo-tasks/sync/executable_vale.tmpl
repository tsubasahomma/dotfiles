set -euo pipefail
cd {{ template "posix_shell_quote.tmpl" .paths.home }}
exec python3 - {{ template "posix_shell_quote.tmpl" .paths.mise }} {{ template "posix_shell_quote.tmpl" .paths.xdg_config }} {{ template "posix_shell_quote.tmpl" .paths.xdg_data }} {{ template "posix_shell_quote.tmpl" .paths.xdg_state }} "$0" <<'PY_GENERATOR'
import sys
{{ include ".chezmoitemplates/generated_files.py" }}
try:
    exec(compile({{ include ".chezmoitemplates/vale_styles.py" | toJson }}, "vale_styles.py", "exec"))
except Exception as error:
    print("[Error] vale_styles.py:", error, file=sys.stderr)
    sys.exit(1)
