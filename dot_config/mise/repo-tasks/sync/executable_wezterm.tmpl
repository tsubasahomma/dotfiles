#!/usr/bin/env bash
# [MISE] description="Sync owned Windows wezterm setting"
set -euo pipefail
if [[ "{{ .is_wsl }}" != "true" || "${CI:-false}" == "true" ]]; then
  echo "[N/A] Windows wezterm sync outside non-CI WSL."
  exit 0
fi
exec python3 - wezterm {{ template "posix_shell_quote.tmpl" (joinPath .paths.xdg_config "wezterm/wezterm.lua") }} <<'PY_WINDOWS_SYNC'
{{ include ".chezmoitemplates/windows_config_sync.py" }}
PY_WINDOWS_SYNC
