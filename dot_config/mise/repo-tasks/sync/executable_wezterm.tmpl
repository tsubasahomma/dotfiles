#!/usr/bin/env bash
{{ "" -}}
# [MISE] description="Sync WezTerm config to Windows host"

set -euo pipefail

IS_WSL="{{ .is_wsl }}"
SRC_CONFIG="{{ .paths.xdg_config }}/wezterm/wezterm.lua"

if [[ "$IS_WSL" != "true" ]]; then
  echo "Skipping WezTerm Windows sync outside WSL."
  exit 0
fi

if [[ "${CI:-false}" == "true" ]]; then
  echo "Skipping WezTerm Windows sync in CI."
  exit 0
fi

if [[ ! -f "$SRC_CONFIG" ]]; then
  echo "WezTerm config not found at $SRC_CONFIG. Skipping sync."
  exit 0
fi

WIN_HOME=$(powershell.exe -NoProfile -NonInteractive -Command '[Console]::Write($env:USERPROFILE)' | tr -d '\r')
if [[ -z "$WIN_HOME" ]]; then
  echo "Windows user profile path could not be resolved from WSL." >&2
  exit 1
fi

DST_CONFIG_WIN="$(wslpath -u "$WIN_HOME")/.wezterm.lua"

echo "Syncing WezTerm config to Windows..."
install -d "$(dirname "$DST_CONFIG_WIN")"
cp -f "$SRC_CONFIG" "$DST_CONFIG_WIN"
echo "WezTerm config synced to Windows."
