#!/usr/bin/env bash
# [MISE] description="Validate and rebuild owned bat cache"
set -euo pipefail
cd {{ template "posix_shell_quote.tmpl" .paths.home }}
exec python3 - {{ template "posix_shell_quote.tmpl" .paths.mise }} {{ template "posix_shell_quote.tmpl" .paths.xdg_config }} {{ template "posix_shell_quote.tmpl" .paths.xdg_cache }} {{ template "posix_shell_quote.tmpl" .paths.xdg_state }} "$0" <<'PY_GENERATOR'
import sys
{{ include ".chezmoitemplates/generated_files.py" }}
try:
    exec(compile({{ include ".chezmoitemplates/bat_cache.py" | toJson }}, "bat_cache.py", "exec"))
except Exception as error:
    print("[Error] bat_cache.py:", error, file=sys.stderr)
    sys.exit(1)
PY_GENERATOR
