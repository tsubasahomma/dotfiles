#!/usr/bin/env bash
# [MISE] description="Provision pnpm global bin directory"
# [MISE] sources=[".config/mise/repo-tasks/provision/pnpm", ".config/mise/config.toml", ".config/mise/conf.d/10-tools.toml"]
# [MISE] outputs={auto=true}
{{/* [Reference]: https://mise.jdx.dev/tasks/file-tasks.html */}}{{ "" -}}

set -euo pipefail

# Force PNPM_HOME to align with the XDG Base Directory specification.
PNPM_HOME="{{ .paths.xdg_data }}/pnpm"

echo "📦 [Node] Configuring pnpm global bin directory..."
pnpm config set global-bin-dir "$PNPM_HOME"

echo "✅ [Node] pnpm configuration converged."
