#!/usr/bin/env bash
# [MISE] description="Validate and build the native pbfile bridge"
set -euo pipefail
{{ if eq .osid "darwin" -}}
cd {{ template "posix_shell_quote.tmpl" .paths.home }}
exec python3 - {{ template "posix_shell_quote.tmpl" .paths.home }} {{ template "posix_shell_quote.tmpl" .paths.xdg_data }} {{ template "posix_shell_quote.tmpl" .paths.xdg_state }} "$0" <<'PY_GENERATOR'
import sys
{{ include ".chezmoitemplates/generated_files.py" }}
try:
    exec(compile({{ include ".chezmoitemplates/pbfile_build.py" | toJson }}, "pbfile_build.py", "exec"))
except Exception as error:
    print("[Error] pbfile_build.py:", error, file=sys.stderr)
    sys.exit(1)
PY_GENERATOR
{{ else -}}
echo "[pbfile] non-macOS: not applicable"
{{ end -}}
