#!/usr/bin/env bash
# [MISE] description="Inspect selected local assets; no authentication or application startup"
set -euo pipefail
{{ includeTemplate "diagnostic_shell.tmpl" . }}
TASK_DIR={{ includeTemplate "posix_shell_quote.tmpl" (joinPath .paths.xdg_config "mise/repo-tasks") }}
for task in security identity nvim vale toolchain npm-backend hubspot completion; do
  if ! /bin/bash "$TASK_DIR/check/$task"; then HAS_ERROR=1; fi
done
if [[ "$HAS_ERROR" -eq 0 ]]; then
  log_ok "Selected local checks passed; warnings and untested runtime/authentication behavior remain."
else
  log_err "Selected local checks failed. No repair was attempted."
fi
exit "$HAS_ERROR"
